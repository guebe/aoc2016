(load "../../aoc2025/srfi-1.scm")
(load "example.scm")
(load "input.scm")

(define (split-input lst)
  (define (loop rest A B C)
    (if (null? rest)
        (cons (reverse (cons (reverse C) A)) (reverse B))
        (let ((c (car rest))
              (rest (cdr rest)))
          (if (char=? c #\[)
	      (loop rest (cons (reverse C) A) B '())
	      (if (char=? c #\])
		  (loop rest A (cons (reverse C) B) '())
                  (loop rest A B (cons c C)))))))
  (loop lst '() '() '()))

; Applies the predicate to each n-element window across the list,
; returning true if the predicate returns true on any application.
(define (any-n pred lst n)
  (define (loop rest remain)
    (and (>= remain n)
         (or (pred rest)
             (loop (cdr rest) (- remain 1)))))
  (loop lst (length lst)))

(define (abba? lst)
  (and (not (char=? (first lst) (second lst)))
       (char=? (first lst) (fourth lst))
       (char=? (second lst) (third lst))))

(define (aba? lst)
  (and (not (char=? (first lst) (second lst)))
       (char=? (first lst) (third lst))))

(define (bab? lst a b)
  (and (char=? (first lst) b)
       (char=? (second lst) a)
       (char=? (third lst) b)))

(define (tls? str)
  (let* ((p (split-input (string->list str)))
         (A (car p))
         (B (cdr p)))
    (and (any (lambda (x) (any-n abba? x 4)) A)
         (not (any (lambda (x) (any-n abba? x 4)) B)))))

(define (ssl? str)
  (let* ((p (split-input (string->list str)))
         (A (car p))
         (B (cdr p)))
    (any (lambda (x)
           (any-n (lambda (a)
                    (and (aba? a)
                         (any (lambda (x)
                                (any-n (lambda (b)
                                         (bab? b (first a) (second a)))
                                       x 3))
                              B)))
                  x 3))
         A)))

(display (count tls? in))
(newline)
(display (count ssl? in))
(newline)
