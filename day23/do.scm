(load "../../aoc2025/srfi-1.scm")
(load "example.scm")
(load "input.scm")

(define (make-reg a b c d)
  (list (cons 'a a) (cons 'b b) (cons 'c c) (cons 'd d)))

(define (run R code)
  (define len (vector-length code))
  (define (reg r) (cdr (assoc r R)))
  (define (val x) (if (number? x) x (reg x)))
  (define (put! r v) (set-cdr! (assoc r R) v))
  (define (change! r f) (let ((e (assoc r R))) (set-cdr! e (f (cdr e)))))
  (define (cpy i pc) (put! (second i) (val (first i))) 1)
  (define (inc i pc) (change! (first i) (lambda (x) (+ x 1))) 1)
  (define (dec i pc) (change! (first i) (lambda (x) (- x 1))) 1)
  (define (jnz i pc) (if (zero? (val (first i))) 1 (val (second i))))
  (define toggle '((jnz . cpy) (cpy . jnz) (inc . dec) (dec . inc) (tgl . inc)))
  (define (tgl i pc) (let ((target (+ pc (reg (first i)))))
                    (if (and (>= target 0) (< target len))
                        (let ((entry (vector-ref code target)))
                          (set-car! entry (cdr (assoc (car entry) toggle)))))) 1)
  (define instructions (list (cons 'jnz jnz) (cons 'inc inc) (cons 'dec dec) (cons 'cpy cpy) (cons 'tgl tgl)))
  (define (exec i pc) ((cdr (assoc (car i) instructions)) (cdr i) pc))
  (define (step pc)
    (if (or (< pc 0) (>= pc len))
        (reg 'a)
        (let ()
          (display pc)
          (display ": ")
          (display (vector-ref code pc))
          (display " - ")
          (display R)
          (newline)
          (step (+ pc (exec (vector-ref code pc) pc))))))
  (step 0))

(display (run (make-reg 7 0 0 0) program))
(newline)
