;(import srfi-1)
(load "input.scm")

(define first car)
(define second cadr)

(define (run code a)
  (let* ((regs (list (cons 'a a) (cons 'b 0) (cons 'c 0) (cons 'd 0)))
         (get-reg (lambda (r) (cdr (assoc r regs))))
         (set-reg! (lambda (r v) (set-cdr! (assoc r regs) v)))
         (value (lambda (x) (if (number? x) x (get-reg x)))))
    (define (step pc)
      (if (or (< pc 0) (>= pc (vector-length code)))
          (get-reg 'a)
	  (let* ((jnz (lambda (ins) (if (zero? (value (first ins))) 1 (value (second ins)))))
                 (inc (lambda (ins) (set-reg! (first ins) (+ (get-reg (first ins)) 1)) 1))
                 (dec (lambda (ins) (set-reg! (first ins) (- (get-reg (first ins)) 1)) 1))
                 (cpy (lambda (ins) (set-reg! (second ins) (value (first ins))) 1))
	         (rep '((jnz . cpy) (cpy . jnz) (inc . dec) (dec . inc) (tgl . inc)))
	         (tgl (lambda (ins) (let ((tgt (+ pc (get-reg (first ins)))))
				         (if (and (>= tgt 0) (< tgt (vector-length code)))
					     (set-car! (vector-ref code tgt) (cdr (assoc (car (vector-ref code tgt)) rep))))
					 1)))
                 (insn (list (cons 'jnz jnz) (cons 'inc inc) (cons 'dec dec) (cons 'cpy cpy) (cons 'tgl tgl)))
                 (exec (lambda (ins) ((cdr (assoc (car ins) insn)) (cdr ins)))))
	    (display pc)
	    (display ": ")
	    (display (vector-ref code pc))
	    (display " - ")
	    (display regs)
	    (newline)
            (step (+ pc (exec (vector-ref code pc)))))))
    (step 0)))

