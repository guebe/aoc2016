(load "../../aoc2025/srfi-1.scm")
(load "input.scm")

(define (make-reg a b c d)
  (list (cons 'a a) (cons 'b b) (cons 'c c) (cons 'd d)))

(define (run R code)
  (define signal (list '()))
  (define len (vector-length code))
  (define (reg r) (cdr (assoc r R)))
  (define (val x) (if (number? x) x (reg x)))
  (define (put! r v) (set-cdr! (assoc r R) v))
  (define (change! r f) (let ((e (assoc r R))) (set-cdr! e (f (cdr e)))))
  (define (cpy i) (put! (second i) (val (first i))) 1)
  (define (inc i) (change! (first i) (lambda (x) (+ x 1))) 1)
  (define (dec i) (change! (first i) (lambda (x) (- x 1))) 1)
  (define (jnz i) (if (zero? (val (first i))) 1 (val (second i))))
  (define (out i)
    (let ((s (cons (val (first i)) (car signal))))
      (set-car! signal s)
      (if (< (length s) 24) 1 (let () (display s) 999999))))
  (define instructions (list (cons 'jnz jnz) (cons 'inc inc) (cons 'dec dec) (cons 'cpy cpy) (cons 'out out)))
  (define (exec i) ((cdr (assoc (car i) instructions)) (cdr i)))
  (define (step pc)
    (if (or (< pc 0) (>= pc len))
        (reg 'a)
        (step (+ pc (exec (vector-ref code pc))))))
  (step 0))

(define (sim i)
    (display i)
    (display ": ")
    (run (make-reg i 0 0 0) program)
    (newline)
    (sim (+ i 1)))
(sim 0)
